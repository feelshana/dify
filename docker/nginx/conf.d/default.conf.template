# Please do not directly edit this file. Instead, modify the .env variables related to NGINX configuration.

server {
    listen ${NGINX_PORT};
    server_name ${NGINX_SERVER_NAME};

    location /dify/console/api {
      proxy_pass http://api:5001/console/api;
      include proxy.conf;
    }

    location /dify/api {
      proxy_pass http://api:5001/api;
      include proxy.conf;
    }

    location /dify/v1 {
      proxy_pass http://api:5001/v1;
      include proxy.conf;
    }

    location /dify/files {
      proxy_pass http://api:5001/files;
      include proxy.conf;
    }

    location /dify/explore {
      proxy_pass http://web:3000;
      include proxy.conf;
    }

    location /dify/e/ {
      proxy_pass http://plugin_daemon:5002/e/;
      proxy_set_header Dify-Hook-Url $scheme://$host$request_uri;
      include proxy.conf;
    }

    location /dify/lineage/graph/ {
        proxy_pass http://172.17.0.1:8006/api/v1/lineage/graph/;
        include proxy.conf;
    }

    location /dify/lineage/data-graph/ {
        proxy_pass http://172.17.0.1:8006/api/v1/lineage/data-graph/;
        include proxy.conf;
    }

    location /dify/lineage/auth/ {
        proxy_pass http://172.17.0.1:8006/api/v1/lineage/auth/;
        include proxy.conf;
    }

    location /dify/lineage/ {
        proxy_pass http://172.17.0.1:3100/;
        include proxy.conf;
    }


    location /dify {
      proxy_pass http://web:3000;
      include proxy.conf;
    }

    location /dify/proxy {
        proxy_pass http://172.17.0.1:8002;
        include proxy.conf;
    }

    location /dify/docs {
        proxy_pass http://10.194.2.66:8006/admin/docrepo;
        include proxy.conf;
    }

    location /dify/docs/api/ {
        proxy_pass http://10.194.2.66:8006/api/;
        include proxy.conf;
    }

    # placeholder for acme challenge location
    ${ACME_CHALLENGE_LOCATION}

    # placeholder for https config defined in https.conf.template
    ${HTTPS_CONFIG}
}
